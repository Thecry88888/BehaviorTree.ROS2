<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
    <BehaviorTree ID="MainTree">
        <Sequence name="MainProcess">
            
            <Fallback name="Stage1_Fan">
                <Condition ID="IsFanPlaced" fan_status="{IsFanPlaced}"/>
                <Fallback name="Fan_Action_Group">
                    <Sequence name="Fan_Steps">
                        <Action ID="CameraLocateFan" target_pose="{FanPose}"/>
                        <Action ID="MoveTo" goal="{FanPose}" _description="Move to pick the fan"/>
                        <Action ID="Gripper" gripCommand="{GRIP}" _description="Grip the fan"/>
                        <Action ID="MoveTo" goal="{FixturePose}" _description="Move to place the fan"/>
                        <Action ID="Gripper" gripCommand="{PUT}" _description="Place the fan"/>
                        <Action ID="UpdateBlackboard" key="IsFanPlaced" value="true"/>
                    </Sequence>
                    <SubTree ID="RecoverySubtree"/> </Fallback>
            </Fallback>

            <Fallback name="Stage2_Connector">
                <Condition ID="IsConnectorGripped" grip_status="{IsConnectorGripped}"/>
                <Fallback name="Grip_Action_Group">
                    <Sequence name="Grip_Steps">
                        <Action ID="CameraSwitch" camera="eye_in_hand"/>
                        <Action ID="CameraLocateConnector" target_pose="{ConnPose}"/>
                        <Action ID="MoveTo" goal="{ConnPose}" _description="Move to pick the connector along planned points"/>
                        <Action ID="Gripper" gripCommand="{GRIP}" _description="Grip the connector"/>
                        <Action ID="UpdateBlackboard" key="IsConnectorGripped" value="true"/>
                    </Sequence>
                    <SubTree ID="RecoverySubtree"/>
                </Fallback>
            </Fallback>

            <Fallback name="Stage3_Plug">
                <Condition ID="IsConnectorPlugged" plug_status="{IsConnectorPlugged}"/>
                <Fallback name="Plug_Action_Group">
                    <Sequence name="Plug_Steps">
                        <Action ID="SensorLocateConnector"/>
                        <Action ID="MoveTo" goal="linear_insert" _description="Move to plug the connector along planned points"/>
                        <Action ID="Gripper" gripCommand="{PUT}" _description="Place the connector"/>
                        <Action ID="UpdateBlackboard" key="IsConnectorPlugged" value="true"/>
                    </Sequence>
                    <SubTree ID="RecoverySubtree"/>
                </Fallback>
            </Fallback>

        </Sequence>
    </BehaviorTree>

    <BehaviorTree ID="RecoverySubtree">
        <Sequence name="Recovery_Logic">
            <Action ID="Gripper" gripCommand="{PUT}" _description="Release the gripper"/>
            <Action ID="MoveTo" goal="init_pose" _description="Move to initial pose"/>
            <AlwaysFailure/> </Sequence>
    </BehaviorTree>

    <!-- Description of Node Models (used by Groot) -->
    <TreeNodesModel>
        <Condition ID="IsFanPlaced"
               editable="true">
               <input_port name="fan_status"/>
        </Condition>
        <Condition ID="IsConnectorGripped"
               editable="true">
               <input_port name="grip_status"/>
        </Condition>
        <Condition ID="IsConnectorPlugged"
               editable="true">
               <input_port name="plug_status"/>
        </Condition>
        <Action ID="CameraLocateFan"
                editable="true">
                <input_port name="target_pose"/>
        </Action>
        <Action ID="MoveTo"
                editable="true">
                <input_port name="goal"/>
        </Action>
        <Action ID="Gripper" >
                <input_port name="gripCommand"/>
        </Action>
        <Action ID="UpdateBlackboard"
                editable="true">
                <input_port name="key"/>
                <input_port name="value"/>
        </Action>
        <Action ID="CameraSwitch"
                editable="true">
                <input_port name="camera"/>
        </Action>
        <Action ID="CameraLocateConnector"
                editable="true">
                <input_port name="target_pose"/>
        </Action>
        <Action ID="SensorLocateConnector"
                editable="true"/>
    </TreeNodesModel>

</root>